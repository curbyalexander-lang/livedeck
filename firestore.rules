rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Replace the email below with the Google account(s) allowed to build and present decks.
service cloud.firestore {
  match /databases/{database}/documents {

    function isPresenter() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['curbyalexander@gmail.com'];
    }
    function session(code) {
      return get(/databases/$(database)/documents/sessions/$(code)).data;
    }

    // Decks: private to their owner.
    match /decks/{deckId} {
      allow create: if isPresenter() && request.resource.data.owner == request.auth.uid;
      allow read, update, delete: if isPresenter() && resource.data.owner == request.auth.uid;
    }

    // Your saved themes and custom widgets: private to their owner.
    match /themes/{id} {
      allow create: if isPresenter() && request.resource.data.owner == request.auth.uid;
      allow read, update, delete: if isPresenter() && resource.data.owner == request.auth.uid;
    }
    match /widgets/{id} {
      allow create: if isPresenter() && request.resource.data.owner == request.auth.uid;
      allow read, update, delete: if isPresenter() && resource.data.owner == request.auth.uid;
    }

    // Live sessions: anyone signed in (including anonymous audience phones) can read the
    // current slide; only the presenter who created a session can change it.
    match /sessions/{code} {
      allow read: if request.auth != null;
      allow create: if isPresenter() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isPresenter() && resource.data.owner == request.auth.uid;

      // Presenter-only state shared by the display and the remote: drawings, timer, heartbeat.
      match /stage/{doc} {
        allow read, write: if isPresenter() && session(code).owner == request.auth.uid;
      }

      // One response document per audience member. Phones write only their own,
      // only while the session is open; only the presenter can read everyone's.
      match /responses/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || session(code).owner == request.auth.uid);
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && session(code).open == true
          && request.resource.data.keys().hasOnly(['r', 'updatedAt'])
          && request.resource.data.r is map
          && request.resource.data.r.size() <= 100;
      }
    }
  }
}
